# Copy to .env and fill in. .env is git-ignored.

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=varthaai_db
DB_USER=varthaai
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Razorpay (storefront checkout)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Storefront (Phase 15)
STOREFRONT_BRAND_ID=1

# 2Factor OTP — blank disables OTP send/verify
TWOFACTOR_API_KEY=
OTP_TEMPLATE=Varthaai Login OTP

# Google reCAPTCHA v3 — blank secret skips verification (dev)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=

# Telegram new-order notifications — blank token skips them
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_CHAT_ID=
# Daily employee work-session report (sessions_tracking app, 19:30 IST) —
# a separate chat from TELEGRAM_GROUP_CHAT_ID above. Blank => the report
# logs an error and skips sending without crashing other Celery jobs.
TELEGRAM_CHAT_ID=

WHATSAPP_BUSINESS_NUMBER=919400557445

# Loyalty points
PURCHASE_POINTS_PERCENTAGE=10
REVIEW_POINTS=5
FEEDBACK_POINTS=5
REFERRAL_POINTS=50

# --- Celery / Redis (Debugger Agent background tasks) ---
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# --- Debugger Agent (super-admin RCA + PR bot) ---
# Claude Agent SDK key — ROTATE if it was ever committed.
ANTHROPIC_API_KEY=
DEBUGGER_MODEL=claude-sonnet-5
# Dedicated Postgres SELECT-only role (see deploy/DEBUGGER.md)
DB_RO_USER=varthaai_ro
DB_RO_PASSWORD=
# DB_RO_NAME / DB_RO_HOST / DB_RO_PORT default to the main DB values
# Isolated worktree for building PR branches (NOT the prod checkout)
DEBUGGER_REPO_DIR=
# Log sources the agent may read (read-only)
DEBUGGER_LOG_UNIT=varthaai
DEBUGGER_NGINX_ACCESS_LOG=/var/log/nginx/varthaai.access.log
DEBUGGER_NGINX_ERROR_LOG=/var/log/nginx/varthaai.error.log
# GitHub PR creation (Phase 2) — keep out of git
GITHUB_TOKEN=
GITHUB_REPO=armedjuror/varthaai-new
GITHUB_DEFAULT_BRANCH=main

# --- Business Analysis MCP server (bizmcp app) ---
# Bearer token required on every request to the MCP endpoint. Required —
# the server refuses all requests if blank. Generate with e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_API_KEY=
# Hard cap on rows any single run_readonly_sql call may return.
MCP_DB_ROW_LIMIT=200
# Host / Origin headers the MCP transport accepts (DNS-rebinding protection).
# Must include the public domain nginx forwards, or requests get 421.
MCP_ALLOWED_HOSTS=varthaai.com,www.varthaai.com
MCP_ALLOWED_ORIGINS=https://claude.ai,https://claude.com

# --- Content Studio: Planner + Designer Agents (content/agents/) ---
# Plan/text/vision calls (planning, inspiration captioning, brief generation)
# go through the `claude` CLI's own login session, NOT this file's
# ANTHROPIC_API_KEY — see core/claude_cli.py.
CONTENT_TEXT_MODEL=claude-sonnet-5
# Image generation only — Claude doesn't generate images, so this one call is Gemini.
GEMINI_API_KEY=
GEMINI_POSTER_MODEL=gemini-3-pro-image-preview
