# Copy to .env and fill in. .env is git-ignored.

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=varthaai_db
DB_USER=varthaai
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Razorpay (storefront checkout)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Storefront (Phase 15)
STOREFRONT_BRAND_ID=1

# 2Factor OTP — blank disables OTP send/verify
TWOFACTOR_API_KEY=
OTP_TEMPLATE=Varthaai Login OTP

# Google reCAPTCHA v3 — blank secret skips verification (dev)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=

# Telegram new-order notifications — blank token skips them
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_CHAT_ID=

WHATSAPP_BUSINESS_NUMBER=919400557445

# Loyalty points
PURCHASE_POINTS_PERCENTAGE=10
REVIEW_POINTS=5
FEEDBACK_POINTS=5
REFERRAL_POINTS=50
